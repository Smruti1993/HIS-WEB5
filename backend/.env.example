PORT=5005
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Twilio Configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# EKA CARE
EKA_CARE_CLIENT_ID=
EKA_CARE_CLIENT_SECRET=
EKA_CARE_BASE_URL=https://api.eka.care
EKA_CARE_INIT_AUTH_URL=https://api.eka.care/abdm/api/v1/registration/aadhaar/init
EKA_CARE_CONFIRM_AUTH_URL=https://api.eka.care/abdm/api/v1/registration/aadhaar/verify

# PayU POS Terminal Configuration
PAYU_BASE_URL=https://apitest.payu.in
PAYU_KEY=
PAYU_SALT=
PAYU_ACCOUNT_ID=
PAYU_CALLBACK_BASE_URL=http://localhost:5005
PAYU_ATTEMPT_TTL_SECONDS=300
PAYU_WEBHOOK_TOKEN=
DEFAULT_SALE_CURRENCY=INR
ENABLE_PAYMENT_MOCK=true

# ─────────────────────────────────────────────────────────────
# AI Chat Assistant (✨)
# ─────────────────────────────────────────────────────────────
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Model identifier. Free-tier Flash-class models (15 RPM / 1500 RPD):
#   gemini-2.0-flash   (recommended — latest Flash, free tier)
#   gemini-1.5-flash   (alternative)
# Verify the current model list at: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-2.0-flash

# Feature flag — set to 'false' to disable the AI chat endpoint entirely
AI_CHAT_ENABLED=true

# Max conversation messages sent to Gemini per request (conserves free-tier quota)
AI_CHAT_MAX_HISTORY=10

# Max tool-call loop iterations per request (prevents infinite loops)
AI_CHAT_MAX_TOOL_LOOPS=5

# ⚠️  PRODUCTION CHECKLIST (before handling real patient data):
#   1. Replace demo-token auth with verified tokens (e.g. Supabase Auth JWT)
#   2. Move pending-action store, rate limiter, and cache to Redis or a DB table
#   3. Switch to a paid/compliant Gemini plan (or Ollama) after reviewing DPDP Act / data terms
#   4. Add an audit log retention and access policy on ai_chat_audit

